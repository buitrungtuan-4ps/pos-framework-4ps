# Caddy fronts pos_cloud (ADR-0044): it terminates real TLS and reverse-proxies plaintext to
# the app on the internal Docker network. Cloudflare "Flexible" SSL is forbidden — the origin
# is always real TLS here; if Cloudflare proxies at all it must be Full (strict), the same
# "redirect, never proxy, never Flexible" rule ADR-0011 fixed for tenant hostnames.
#
# This is the DEFAULT Caddyfile: TLS issued automatically over HTTP-01 / TLS-ALPN, no DNS
# provider and no Cloudflare token. It is what the sslip.io fallback uses (and works for any
# domain whose A record points at the box), so :80 and :443 must be reachable from the
# internet — sslip.io satisfies that by resolving <vps-ip>.sslip.io straight to the box, so
# the certificate is real. This is why the sslip.io path runs the stock official caddy image
# and never builds the Cloudflare plugin (deploy/caddy.Dockerfile).
#
# For a Cloudflare-managed domain issuing over DNS-01 (grey-clouded, no inbound :80 to ACME),
# bootstrap.sh swaps in deploy/Caddyfile.cloudflare instead — see ADR-0044.
#
# DOMAIN and ACME_EMAIL come from ./secrets/caddy.env, generated on the box by bootstrap.sh
# (P8b) and never committed.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# pos_cloud speaks plain HTTP on :8080 inside the network. Active health checks against
	# /health take the upstream out of rotation if the app stops answering, so Caddy returns
	# 502 rather than proxying into a dead process.
	reverse_proxy pos_cloud:8080 {
		health_uri /health
		health_interval 10s
		health_timeout 2s
	}
}
