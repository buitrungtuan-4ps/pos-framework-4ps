# The non-secret values of one cell (ADR-0179 C8). Copy this file to deploy/cells/<cell_id>.env
# for each cell the fork runs, and commit it: a reviewer sees a cell's id, countries and address in
# the pull request that changes them. Secrets never go here; they stay in the cell's GitHub
# Environment, or are minted on the box (ADR-0044). The deploy workflow passes these to
# bootstrap.sh, which writes the [cell] section of cloud.toml from them once (docs/deploy-runbook.md).

# The cell id: 3 to 32 of a-z, 0-9 and '-', starting with a letter. Never a bare country code.
CELL_ID=example1
# An optional two-letter country alias that names this cell where a country is written (vn).
CELL_COUNTRY_ALIAS=
# The country this cell's tenants are homed by, and the country its servers run in (ISO 3166-1).
CELL_HOME_COUNTRY=ZZ
CELL_RUNS_IN=ZZ
# The origin this cell answers on: https, no path.
CELL_BASE_URL=https://example1.example.com
# The order a fleet deploy reaches this cell in: lower first. The first cell is the canary.
CANARY_RANK=0
# The country the off-box backups (RCLONE_REMOTE) rest in. backup.sh warns when it is not
# CELL_HOME_COUNTRY, and when it is not recorded (ADR-0179 C7, recorded here in C8).
BACKUP_COUNTRY=ZZ
