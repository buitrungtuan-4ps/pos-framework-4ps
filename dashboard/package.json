{
  "name": "pos-cloud-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "The SolidJS back-office dashboard embedded into pos_cloud (ADR-0060).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && pnpm i18n:lint && pnpm i18n:parity && pnpm contrast && pnpm assets && pnpm installers && pnpm steps && pnpm test && vite build",
    "typecheck": "tsc --noEmit",
    "gen:api": "node ../packages/shared/scripts/gen-api.mjs ../docs/openapi-admin.json src/api/generated/admin.d.ts",
    "lint": "eslint . && node ../packages/shared/scripts/eslint-baseline.mjs --check",
    "i18n:lint": "node ../packages/shared/scripts/i18n-lint.mjs",
    "installers": "node scripts/installer-syntax.mjs",
    "contrast": "node ../packages/shared/scripts/wcag-contrast.mjs",
    "steps": "node scripts/step-budget.mjs",
    "preview": "vite preview",
    "i18n:parity": "node ../packages/shared/scripts/i18n-parity.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets": "node scripts/asset-weight.mjs",
    "replay": "playwright test"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.0",
    "intl-messageformat": "^12.1.3",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.0.9",
    "eslint": "10.12.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.2",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
