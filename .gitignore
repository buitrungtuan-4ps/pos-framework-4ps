/target/
**/*.rs.bk

# Never commit secrets. CI scans for them too, but the scan is a safety net, not a
# permission slip (CONTRIBUTING.md §8).
.env
.env.*
*.key
*.pem
config.toml
/deploy/secrets/

# Database backups hold T1/T2 data and must never be committed (ADR-0046); backup.sh writes
# them here by default.
/backups/
/deploy/backups/

# Vendored sources are shipped as a release artifact rather than committed: the
# windows-targets family ships prebuilt .lib blobs, and git keeps every version of
# them forever. engineering-guide.md §5 sanctions either form ("committed, or
# archived somewhere we control").
/vendor/

/ui/node_modules/
/ui/dist/
# What the browser step gate leaves behind: traces and reports for a failed
# replay (ADR-0109). Diagnostic output, regenerated on every run.
/ui/test-results/
/ui/playwright-report/

# What the screen walk leaves behind: a PNG of every screen at every device size,
# plus the index that names them (`ui/tests/screens.spec.mjs`). A record, regenerated
# on demand and stale the moment a component changes — the harness is the artifact,
# not its output.
/ui/screenshots/
/dashboard/test-results/
/dashboard/playwright-report/
/dashboard/node_modules/
/dashboard/dist/
