{
  "_about": "Shared vectors for package variant resolution (ADR-0189 decision 4). pos-core (Rust) and the till (TypeScript) each run every case. A weekday is 0 for Monday to 6 for Sunday; a schedule's days is the 7-bit mask with Monday as bit 0. An absent `expect` in current_time_slot is no current slot.",
  "resolve": [
    {"name": "only the base variant answers", "variants": [{"body": "base"}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "base"},
    {"name": "nothing signed in, no device: the base", "variants": [{"body": "base"}, {"body": "tablet", "selector": {"device_class": "DEVICE_CLASS_TABLET"}}], "context": {}, "expect": "base"},
    {"name": "a matching class beats the base", "variants": [{"body": "base"}, {"body": "terminal", "selector": {"device_class": "DEVICE_CLASS_TERMINAL"}}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "terminal"},
    {"name": "a class that does not match is no candidate", "variants": [{"body": "base"}, {"body": "tablet", "selector": {"device_class": "DEVICE_CLASS_TABLET"}}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "base"},
    {"name": "a device of unknown class matches no class", "variants": [{"body": "base"}, {"body": "terminal", "selector": {"device_class": "DEVICE_CLASS_TERMINAL"}}], "context": {"device_id": "01J00000000000000000000D01"}, "expect": "base"},
    {"name": "a class from a newer release matches nothing", "variants": [{"body": "base"}, {"body": "newer", "selector": {"device_class": "DEVICE_CLASS_WRISTWATCH"}}], "context": {"device_class": "DEVICE_CLASS_WRISTWATCH"}, "expect": "base"},
    {"name": "a device named by id beats one named by class", "variants": [{"body": "base"}, {"body": "class", "selector": {"device_class": "DEVICE_CLASS_TERMINAL"}}, {"body": "id", "selector": {"device_id": "01J00000000000000000000D01"}}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "id"},
    {"name": "another device's id is no candidate", "variants": [{"body": "base"}, {"body": "other", "selector": {"device_id": "01J00000000000000000000D02"}}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "base"},
    {"name": "more dimensions win", "variants": [{"body": "base"}, {"body": "device", "selector": {"device_id": "01J00000000000000000000D01"}}, {"body": "role and channel", "selector": {"role_id": "01J00000000000000000000R01", "sales_channel": "SALES_CHANNEL_DINE_IN"}}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "role and channel"},
    {"name": "a class and a slot beat a device id alone", "variants": [{"body": "base"}, {"body": "id", "selector": {"device_id": "01J00000000000000000000D01"}}, {"body": "class and slot", "selector": {"device_class": "DEVICE_CLASS_TERMINAL", "time_slot_id": "lunch"}}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "class and slot"},
    {"name": "one dimension each: device before role", "variants": [{"body": "base"}, {"body": "role", "selector": {"role_id": "01J00000000000000000000R01"}}, {"body": "device", "selector": {"device_class": "DEVICE_CLASS_TERMINAL"}}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "device"},
    {"name": "one dimension each: role before sales channel", "variants": [{"body": "base"}, {"body": "channel", "selector": {"sales_channel": "SALES_CHANNEL_DINE_IN"}}, {"body": "role", "selector": {"role_id": "01J00000000000000000000R01"}}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "role"},
    {"name": "one dimension each: sales channel before time slot", "variants": [{"body": "base"}, {"body": "slot", "selector": {"time_slot_id": "lunch"}}, {"body": "channel", "selector": {"sales_channel": "SALES_CHANNEL_DINE_IN"}}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "channel"},
    {"name": "two dimensions each: role decides before id over class", "variants": [{"body": "base"}, {"body": "id and channel", "selector": {"device_id": "01J00000000000000000000D01", "sales_channel": "SALES_CHANNEL_DINE_IN"}}, {"body": "class and role", "selector": {"device_class": "DEVICE_CLASS_TERMINAL", "role_id": "01J00000000000000000000R01"}}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "class and role"},
    {"name": "two dimensions each, same dimensions: id over class", "variants": [{"body": "base"}, {"body": "class and role", "selector": {"device_class": "DEVICE_CLASS_TERMINAL", "role_id": "01J00000000000000000000R01"}}, {"body": "id and role", "selector": {"device_id": "01J00000000000000000000D01", "role_id": "01J00000000000000000000R01"}}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "id and role"},
    {"name": "two roles held, each with a variant: the one listed first", "variants": [{"body": "base"}, {"body": "second role", "selector": {"role_id": "01J00000000000000000000R02"}}, {"body": "first role", "selector": {"role_id": "01J00000000000000000000R01"}}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "second role"},
    {"name": "a role not held is no candidate", "variants": [{"body": "base"}, {"body": "role", "selector": {"role_id": "01J00000000000000000000R09"}}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "base"},
    {"name": "no order on screen matches no channel", "variants": [{"body": "base"}, {"body": "takeaway", "selector": {"sales_channel": "SALES_CHANNEL_TAKEAWAY"}}], "context": {"device_class": "DEVICE_CLASS_TERMINAL"}, "expect": "base"},
    {"name": "the current slot matches", "variants": [{"body": "base"}, {"body": "lunch", "selector": {"time_slot_id": "lunch"}}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "lunch"},
    {"name": "outside every slot, a slot variant is no candidate", "variants": [{"body": "base"}, {"body": "lunch", "selector": {"time_slot_id": "lunch"}}], "context": {"device_class": "DEVICE_CLASS_TERMINAL"}, "expect": "base"},
    {"name": "all four dimensions", "variants": [{"body": "base"}, {"body": "three", "selector": {"device_class": "DEVICE_CLASS_TERMINAL", "role_id": "01J00000000000000000000R01", "sales_channel": "SALES_CHANNEL_DINE_IN"}}, {"body": "four", "selector": {"device_id": "01J00000000000000000000D01", "role_id": "01J00000000000000000000R02", "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "four"},
    {"name": "the base listed last still answers", "variants": [{"body": "tablet", "selector": {"device_class": "DEVICE_CLASS_TABLET"}}, {"body": "base"}], "context": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TERMINAL", "role_ids": ["01J00000000000000000000R01", "01J00000000000000000000R02"], "sales_channel": "SALES_CHANNEL_DINE_IN", "time_slot_id": "lunch"}, "expect": "base"}
  ],
  "current_time_slot": [
    {"name": "no slots, no current slot", "time_slots": [], "at": {"weekday": 0, "minute_of_day": 700}, "expect": null},
    {"name": "inside a window", "time_slots": [{"time_slot_id": "lunch", "label_key": "package.slot.lunch", "schedules": [{"days": 31, "start_minute": 660, "end_minute": 840}]}], "at": {"weekday": 0, "minute_of_day": 700}, "expect": "lunch"},
    {"name": "the start minute is inside", "time_slots": [{"time_slot_id": "lunch", "label_key": "package.slot.lunch", "schedules": [{"days": 31, "start_minute": 660, "end_minute": 840}]}], "at": {"weekday": 0, "minute_of_day": 660}, "expect": "lunch"},
    {"name": "the end minute is outside", "time_slots": [{"time_slot_id": "lunch", "label_key": "package.slot.lunch", "schedules": [{"days": 31, "start_minute": 660, "end_minute": 840}]}], "at": {"weekday": 0, "minute_of_day": 840}, "expect": null},
    {"name": "a weekday window is closed on Saturday", "time_slots": [{"time_slot_id": "lunch", "label_key": "package.slot.lunch", "schedules": [{"days": 31, "start_minute": 660, "end_minute": 840}]}], "at": {"weekday": 5, "minute_of_day": 700}, "expect": null},
    {"name": "a window that wraps midnight, before midnight", "time_slots": [{"time_slot_id": "late", "label_key": "package.slot.late", "schedules": [{"days": 127, "start_minute": 1320, "end_minute": 120}]}], "at": {"weekday": 3, "minute_of_day": 1400}, "expect": "late"},
    {"name": "a window that wraps midnight, after midnight", "time_slots": [{"time_slot_id": "late", "label_key": "package.slot.late", "schedules": [{"days": 127, "start_minute": 1320, "end_minute": 120}]}], "at": {"weekday": 4, "minute_of_day": 60}, "expect": "late"},
    {"name": "two slots hold the moment: the one listed first", "time_slots": [{"time_slot_id": "weekday_daytime", "label_key": "package.slot.weekday_daytime", "schedules": [{"days": 31, "start_minute": 540, "end_minute": 1080}]}, {"time_slot_id": "lunch", "label_key": "package.slot.lunch", "schedules": [{"days": 31, "start_minute": 660, "end_minute": 840}]}], "at": {"weekday": 2, "minute_of_day": 700}, "expect": "weekday_daytime"},
    {"name": "two slots hold the moment, listed the other way", "time_slots": [{"time_slot_id": "lunch", "label_key": "package.slot.lunch", "schedules": [{"days": 31, "start_minute": 660, "end_minute": 840}]}, {"time_slot_id": "weekday_daytime", "label_key": "package.slot.weekday_daytime", "schedules": [{"days": 31, "start_minute": 540, "end_minute": 1080}]}], "at": {"weekday": 2, "minute_of_day": 700}, "expect": "lunch"},
    {"name": "a later slot is current once the earlier one ends", "time_slots": [{"time_slot_id": "lunch", "label_key": "package.slot.lunch", "schedules": [{"days": 31, "start_minute": 660, "end_minute": 840}]}, {"time_slot_id": "weekday_daytime", "label_key": "package.slot.weekday_daytime", "schedules": [{"days": 31, "start_minute": 540, "end_minute": 1080}]}], "at": {"weekday": 2, "minute_of_day": 900}, "expect": "weekday_daytime"},
    {"name": "a slot of two windows, the second holds it", "time_slots": [{"time_slot_id": "weekend", "label_key": "package.slot.weekend", "schedules": [{"days": 32, "start_minute": 0, "end_minute": 1440}, {"days": 64, "start_minute": 0, "end_minute": 1440}]}], "at": {"weekday": 6, "minute_of_day": 10}, "expect": "weekend"}
  ],
  "check": [
    {"name": "a base and distinct selectors pass", "variants": [{"body": "base"}, {"body": "a", "selector": {"device_class": "DEVICE_CLASS_TABLET"}}, {"body": "b", "selector": {"time_slot_id": "lunch"}}], "time_slots": [{"time_slot_id": "lunch", "label_key": "package.slot.lunch", "schedules": [{"days": 31, "start_minute": 660, "end_minute": 840}]}], "expect": "OK"},
    {"name": "no base variant", "variants": [{"body": "a", "selector": {"device_class": "DEVICE_CLASS_TABLET"}}], "time_slots": [], "expect": "NO_BASE_VARIANT"},
    {"name": "two base variants share a selector", "variants": [{"body": "base"}, {"body": "again"}], "time_slots": [], "expect": "SAME_SELECTOR"},
    {"name": "two variants share a selector", "variants": [{"body": "base"}, {"body": "a", "selector": {"role_id": "01J00000000000000000000R01"}}, {"body": "b", "selector": {"role_id": "01J00000000000000000000R01"}}], "time_slots": [], "expect": "SAME_SELECTOR"},
    {"name": "a device named by id and by class", "variants": [{"body": "base"}, {"body": "a", "selector": {"device_id": "01J00000000000000000000D01", "device_class": "DEVICE_CLASS_TABLET"}}], "time_slots": [], "expect": "DEVICE_STATED_TWICE"},
    {"name": "a slot the package does not declare", "variants": [{"body": "base"}, {"body": "a", "selector": {"time_slot_id": "dinner"}}], "time_slots": [{"time_slot_id": "lunch", "label_key": "package.slot.lunch", "schedules": [{"days": 31, "start_minute": 660, "end_minute": 840}]}], "expect": "UNKNOWN_TIME_SLOT"}
  ]
