//! {{purpose}}
//!
//! The shape an e-invoice adapter here has ([ADR-0176](../../../../docs/adr/0176-the-adapter-and-country-standard.md)):
//!
//! - **The offline half, shared.** [`SandboxEInvoice`] wraps `pos_country::offline`'s allocator,
//!   which keeps the port's hardest rules: numbers from pre-allocated ranges so a store issues with
//!   no internet, one number per bill however often it is retried, never a number twice, and a
//!   refusal rather than an invented number when a range runs out.
//! - **The submission, the adapter's own.** The sandbox contacts no authority. A provider adapter
//!   adds its transport here, submits what the store issued, writes the number in the shape the
//!   authority prescribes, and keeps the offline path.
//!
//! The sandbox is [`PROVIDER`], `einvoice.sandbox`, and never a place a real legal submission goes.

use core::num::NonZeroU32;

use pos_country::offline::OfflineFiscalization;
use pos_ports::PortError;
use pos_ports::fiscalization::{
    Fiscalization, InvoiceNumber, InvoiceRange, InvoiceRequest, IssuedInvoice, ReconciliationReport,
};
use pos_proto::{CalendarDate, StoreId};
use pos_providers::{Family, ProviderDescriptor};

/// This adapter as the provider catalogue lists it: a sandbox, which serves every country and asks
/// for no settings.
pub static PROVIDER: ProviderDescriptor = ProviderDescriptor {
    provider_id: "einvoice.sandbox",
    family: Family::EInvoice,
    name_key: "provider.einvoice.sandbox",
    countries: &[],
    fields: &[],
    capabilities: &[],
    sandbox: true,
};

/// `Fiscalization` over a locally allocated range, submitting nowhere.
#[derive(Debug, Clone)]
pub struct SandboxEInvoice(OfflineFiscalization);

impl Default for SandboxEInvoice {
    fn default() -> Self {
        Self::new()
    }
}

impl SandboxEInvoice {
    /// A sandbox with no ranges allocated.
    #[must_use]
    pub fn new() -> Self {
        // The series, then the index: a format that drops the series hands the same number out
        // twice after a second allocation.
        Self(OfflineFiscalization::new("sandbox", |series, index| {
            format!("SBX{series:04}/{index:06}")
        }))
    }
}

impl Fiscalization for SandboxEInvoice {
    async fn allocate_range(
        &self,
        store_id: StoreId,
        count: NonZeroU32,
    ) -> Result<InvoiceRange, PortError> {
        self.0.allocate_range(store_id, count).await
    }

    async fn issue(&self, request: &InvoiceRequest) -> Result<IssuedInvoice, PortError> {
        self.0.issue(request).await
    }

    async fn look_up(
        &self,
        invoice_number: &InvoiceNumber,
    ) -> Result<Option<IssuedInvoice>, PortError> {
        self.0.look_up(invoice_number).await
    }

    async fn reconcile(
        &self,
        store_id: StoreId,
        on: CalendarDate,
    ) -> Result<ReconciliationReport, PortError> {
        self.0.reconcile(store_id, on).await
    }
}

#[cfg(test)]
mod tests {
    use core::num::NonZeroU32;

    use pos_fakes::executor::run_ready;
    use pos_ports::fiscalization::Fiscalization;
    use pos_proto::{StoreId, Ulid};
    use pos_providers::Registry;

    use super::{PROVIDER, SandboxEInvoice};

    #[test]
    fn the_catalogue_accepts_this_adapters_descriptor() {
        let registry = Registry::new([&PROVIDER]).expect("a well-formed descriptor");
        assert!(registry.get("einvoice.sandbox").is_some());
    }

    #[test]
    fn two_ranges_never_share_a_number() {
        // The obligation the number format carries, which the shared suite does not reach.
        let fiscal = SandboxEInvoice::new();
        let store = StoreId::new(Ulid::from_u128(1));
        let count = NonZeroU32::new(4).expect("4 is not zero");
        let first = run_ready(fiscal.allocate_range(store, count)).expect("a range");
        let second = run_ready(fiscal.allocate_range(store, count)).expect("a second range");
        for number in &first.numbers {
            assert!(
                !second.numbers.contains(number),
                "{number:?} was handed out by both ranges"
            );
        }
    }
}
