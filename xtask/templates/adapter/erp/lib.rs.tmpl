//! {{purpose}}
//!
//! The shape every ERP adapter here has ([ADR-0176](../../../../docs/adr/0176-the-adapter-and-country-standard.md)):
//!
//! - **A transport seam.** [`Transport`] is the only thing that talks to the ERP. It is handed each
//!   batch with [`ErpBatch::idempotency_key`], the one key the port defines for a day's posting, and
//!   answers in the ERP's own terms: posted, already posted, an unknown account, or a closed period.
//!   A real adapter puts the ERP's API client behind it; the contract test puts an in-memory ERP
//!   behind it.
//! - **A pure core.** [`SandboxErp`] implements `ErpSink` over any transport and maps those answers to
//!   the port's: an exact revision posted again is `already_exists`, which a caller treats as
//!   success; an unknown account is `invalid_argument` and posts nothing; a closed period is
//!   `failed_precondition`, a conversation for finance rather than a retry; an unreachable ERP is
//!   `unavailable`.
//!
//! Amounts stay integer minor units from the batch to the transport, and a posting carries
//! accounts and amounts only: no person's details, so nothing here can log one. The sandbox is
//! [`PROVIDER`], `erp.sandbox`.

use pos_ports::{ErpBatch, ErpPostingRef, ErpSink, PortError, PortName};
use pos_proto::{BusinessDate, StoreId};
use pos_providers::{Family, ProviderDescriptor};

/// This adapter as the provider catalogue lists it: a sandbox, which serves every country and asks
/// for no settings.
pub static PROVIDER: ProviderDescriptor = ProviderDescriptor {
    provider_id: "erp.sandbox",
    family: Family::Erp,
    name_key: "provider.erp.sandbox",
    countries: &[],
    fields: &[],
    capabilities: &[],
    sandbox: true,
};

/// The ERP, as the adapter sees it.
pub trait Transport: Send + Sync {
    /// Submits `batch` under `key`, the batch's idempotency key.
    ///
    /// # Errors
    ///
    /// [`Unreachable`] if the ERP cannot be reached.
    fn submit(&self, key: &str, batch: &ErpBatch) -> Result<Answer, Unreachable>;

    /// The latest posting for a store's trading day, or `None`.
    ///
    /// # Errors
    ///
    /// [`Unreachable`] if the ERP cannot be reached.
    fn latest(
        &self,
        store_id: StoreId,
        business_date: BusinessDate,
    ) -> Result<Option<ErpPostingRef>, Unreachable>;
}

/// The ERP could not be reached.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Unreachable;

/// What the ERP says about a submission.
#[derive(Debug, Clone, PartialEq, Eq)]
pub enum Answer {
    /// Posted, under this document reference.
    Posted(ErpPostingRef),
    /// This exact key was posted before; nothing was posted again.
    AlreadyPosted,
    /// An account the ERP does not know; nothing was posted.
    UnknownAccount,
    /// The accounting period is closed; nothing was posted.
    PeriodClosed,
}

/// An `ErpSink` over a [`Transport`].
#[derive(Debug)]
pub struct SandboxErp<T> {
    transport: T,
}

impl<T: Transport> SandboxErp<T> {
    /// An ERP reached through `transport`.
    pub const fn new(transport: T) -> Self {
        Self { transport }
    }

    /// The transport, for a harness to inspect or stage.
    pub const fn transport(&self) -> &T {
        &self.transport
    }
}

impl<T: Transport> ErpSink for SandboxErp<T> {
    fn erp_name(&self) -> &'static str {
        "sandbox"
    }

    async fn post(&self, batch: &ErpBatch) -> Result<ErpPostingRef, PortError> {
        let answer = self
            .transport
            .submit(&batch.idempotency_key(), batch)
            .map_err(|_| unreachable())?;
        match answer {
            Answer::Posted(posting) => Ok(posting),
            Answer::AlreadyPosted => Err(PortError::already_exists(
                PortName::ErpSink,
                "this revision of the day has already posted",
            )),
            Answer::UnknownAccount => Err(PortError::invalid_argument(
                PortName::ErpSink,
                "the ERP does not know an account in this batch",
            )),
            Answer::PeriodClosed => Err(PortError::failed_precondition(
                PortName::ErpSink,
                "the accounting period is closed",
            )),
        }
    }

    async fn posted(
        &self,
        store_id: StoreId,
        business_date: BusinessDate,
    ) -> Result<Option<ErpPostingRef>, PortError> {
        self.transport
            .latest(store_id, business_date)
            .map_err(|_| unreachable())
    }
}

fn unreachable() -> PortError {
    PortError::unavailable(PortName::ErpSink, "the ERP could not be reached")
}

#[cfg(test)]
mod provider_tests {
    use pos_providers::Registry;

    #[test]
    fn the_catalogue_accepts_this_adapters_descriptor() {
        let registry = Registry::new([&super::PROVIDER]).expect("a well-formed descriptor");
        assert!(registry.get("erp.sandbox").is_some());
    }
}
