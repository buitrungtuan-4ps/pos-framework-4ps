// The {{title}} screen, written by `cargo xtask new screen --app dashboard`: it draws its title.
// Test what the screen does here as it grows.

import { cleanup, render, screen } from "@solidjs/testing-library";
import { afterEach, describe, expect, it } from "vitest";

import { t } from "../src/i18n";
import { {{component}} } from "../src/screens/{{component}}";

afterEach(cleanup);

describe("{{component}}", () => {
  it("draws its title", () => {
    render(() => <{{component}} />);
    expect(screen.getByRole("heading", { name: t("{{key}}") })).toBeTruthy();
  });
});
