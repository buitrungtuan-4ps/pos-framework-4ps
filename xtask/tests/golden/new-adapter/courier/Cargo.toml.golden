[package]
name        = "courier-sandbox"
version     = "0.1.0"
description = "A sandbox `ShippingDispatch` over a transport seam, generated by `cargo xtask new adapter`: the `courier.sandbox` provider, and the starting point for a courier adapter."
edition.workspace      = true
rust-version.workspace = true
license.workspace      = true
publish.workspace      = true
repository.workspace   = true

[dependencies]
pos-ports = { path = "../../pos-ports" }
pos-proto = { path = "../../pos-proto" }
pos-providers = { path = "../../pos-providers" }

[dev-dependencies]
pos-contract-tests = { path = "../../pos-contract-tests" }
pos-fakes = { path = "../../pos-fakes" }

[lints]
workspace = true

[package.metadata.pos]
layer = "adapter"
purpose = "A sandbox `ShippingDispatch` over a transport seam, generated by `cargo xtask new adapter`: the `courier.sandbox` provider, and the starting point for a courier adapter."
adrs = [26, 58, 153, 176]
owners = ["@maintainers-architecture"]
