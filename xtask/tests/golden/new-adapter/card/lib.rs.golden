//! A sandbox `PaymentTerminal` over a transport seam, generated by `cargo xtask new adapter`: the `card.sandbox` provider, and the starting point for a card-terminal adapter.
//!
//! The shape every card-terminal adapter here has ([ADR-0176](../../../../docs/adr/0176-the-adapter-and-country-standard.md)):
//!
//! - **A transport seam.** [`Transport`] is the only thing that talks to the terminal and its
//!   acquirer. Its `charge` is idempotent by the payment identifier it is given, the way an
//!   acquirer's idempotency key is: asked twice, it answers the first attempt again and moves no
//!   money. The contract test puts a recorder behind it.
//! - **A pure core.** [`SandboxTerminal`] implements `PaymentTerminal` over any transport and keeps
//!   the port's rules: a terminal that was never reached is `unavailable`; a terminal that was
//!   reached and could not say is [`PaymentOutcome::Unknown`] with its reference, never a decline; a
//!   settled capture is not voided; an unknown reference is `not_found`.
//!
//! No card data crosses either boundary. The sandbox is [`PROVIDER`], `card.sandbox`, and a vendor
//! adapter is written from it once the owner has chosen the vendor.

use pos_ports::{
    PaymentAttempt, PaymentReference, PaymentRequest, PaymentTerminal, PortError, PortName,
};
use pos_proto::ids::PaymentId;
use pos_proto::money::Money;
use pos_proto::wire_enum::Open;
use pos_proto::{PaymentOutcome, Timestamp};
use pos_providers::{Family, ProviderDescriptor};

/// This adapter as the provider catalogue lists it: a sandbox, which serves every country and asks
/// for no settings.
pub static PROVIDER: ProviderDescriptor = ProviderDescriptor {
    provider_id: "card.sandbox",
    family: Family::CardTerminal,
    name_key: "provider.card.sandbox",
    countries: &[],
    fields: &[],
    capabilities: &[],
    sandbox: true,
};

/// The terminal and its acquirer, as the adapter sees them.
pub trait Transport: Send + Sync {
    /// Asks for `amount` against `payment_id`. Idempotent by `payment_id`: a second call answers
    /// the first attempt and moves no money.
    ///
    /// # Errors
    ///
    /// [`Unreachable`] only if the terminal was never reached, so nothing happened.
    fn charge(&self, payment_id: PaymentId, amount: &Money) -> Result<Reply, Unreachable>;

    /// The acquirer's record of `reference`, or `None` if it has none.
    ///
    /// # Errors
    ///
    /// [`Unreachable`] if the acquirer cannot be reached.
    fn query(&self, reference: &str) -> Result<Option<Reply>, Unreachable>;

    /// Reverses the unsettled attempt `reference`, answering its record after, or `None`.
    ///
    /// # Errors
    ///
    /// [`Unreachable`] if the acquirer cannot be reached.
    fn reverse(&self, reference: &str) -> Result<Option<Reply>, Unreachable>;
}

/// The terminal or acquirer could not be reached.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Unreachable;

/// What the acquirer says about one attempt.
#[derive(Debug, Clone, PartialEq, Eq)]
pub struct Reply {
    /// The payment the attempt was for.
    pub payment_id: PaymentId,
    /// The acquirer's reference, present whatever the status.
    pub reference: String,
    /// Where the attempt stands.
    pub status: Status,
    /// The amount asked for.
    pub amount: Money,
    /// When the acquirer recorded it.
    pub at: Timestamp,
}

/// Where an attempt stands, in the acquirer's words.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Status {
    /// The money moved.
    Approved,
    /// The money did not move, and the acquirer said so.
    Declined,
    /// The terminal was reached and could not say: resolve it by looking it up.
    Pending,
}

/// A `PaymentTerminal` over a [`Transport`].
#[derive(Debug)]
pub struct SandboxTerminal<T> {
    transport: T,
}

impl<T: Transport> SandboxTerminal<T> {
    /// A terminal reached through `transport`.
    pub const fn new(transport: T) -> Self {
        Self { transport }
    }

    /// The transport, for a harness to inspect or stage.
    pub const fn transport(&self) -> &T {
        &self.transport
    }
}

impl<T: Transport> PaymentTerminal for SandboxTerminal<T> {
    async fn authorize(&self, request: &PaymentRequest) -> Result<PaymentAttempt, PortError> {
        let reply = self
            .transport
            .charge(request.payment_id, &request.amount)
            .map_err(|_| unreachable())?;
        Ok(attempt(reply))
    }

    async fn look_up(&self, reference: &PaymentReference) -> Result<PaymentAttempt, PortError> {
        let reply = self
            .transport
            .query(reference.as_str())
            .map_err(|_| unreachable())?;
        reply.map(attempt).ok_or_else(not_found)
    }

    async fn void(&self, reference: &PaymentReference) -> Result<PaymentAttempt, PortError> {
        let record = self
            .transport
            .query(reference.as_str())
            .map_err(|_| unreachable())?
            .ok_or_else(not_found)?;
        if record.status == Status::Approved {
            return Err(PortError::failed_precondition(
                PortName::PaymentTerminal,
                "the attempt has already settled; issue a refund instead",
            ));
        }
        let reply = self
            .transport
            .reverse(reference.as_str())
            .map_err(|_| unreachable())?;
        reply.map(attempt).ok_or_else(not_found)
    }
}

/// The port's attempt for an acquirer's reply. `Pending` is `Unknown`, never `Declined`.
fn attempt(reply: Reply) -> PaymentAttempt {
    let outcome = match reply.status {
        Status::Approved => PaymentOutcome::Captured,
        Status::Declined => PaymentOutcome::Declined,
        Status::Pending => PaymentOutcome::Unknown,
    };
    PaymentAttempt {
        payment_id: reply.payment_id,
        reference: PaymentReference::new(reply.reference),
        outcome: Open::from_known(outcome),
        amount: reply.amount,
        at: reply.at,
    }
}

fn unreachable() -> PortError {
    PortError::unavailable(
        PortName::PaymentTerminal,
        "the terminal could not be reached",
    )
}

fn not_found() -> PortError {
    PortError::not_found(
        PortName::PaymentTerminal,
        "the acquirer has no record of this reference",
    )
}

#[cfg(test)]
mod provider_tests {
    use pos_providers::Registry;

    #[test]
    fn the_catalogue_accepts_this_adapters_descriptor() {
        let registry = Registry::new([&super::PROVIDER]).expect("a well-formed descriptor");
        assert!(registry.get("card.sandbox").is_some());
    }
}
