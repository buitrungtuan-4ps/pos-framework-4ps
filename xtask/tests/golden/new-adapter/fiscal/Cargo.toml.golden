[package]
name        = "fiscal-sandbox"
version     = "0.1.0"
description = "A sandbox `Fiscalization` over the shared offline allocator, generated by `cargo xtask new adapter`: the `einvoice.sandbox` provider, and the starting point for an e-invoice adapter."
edition.workspace      = true
rust-version.workspace = true
license.workspace      = true
publish.workspace      = true
repository.workspace   = true

[dependencies]
pos-country = { path = "../../pos-country" }
pos-ports = { path = "../../pos-ports" }
pos-proto = { path = "../../pos-proto" }
pos-providers = { path = "../../pos-providers" }

[dev-dependencies]
pos-contract-tests = { path = "../../pos-contract-tests" }
pos-fakes = { path = "../../pos-fakes" }

[lints]
workspace = true

[package.metadata.pos]
layer = "adapter"
purpose = "A sandbox `Fiscalization` over the shared offline allocator, generated by `cargo xtask new adapter`: the `einvoice.sandbox` provider, and the starting point for an e-invoice adapter."
adrs = [26, 153, 176]
owners = ["@maintainers-architecture"]
