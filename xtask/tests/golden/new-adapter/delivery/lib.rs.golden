//! A sandbox `DeliveryVendor` over a transport seam, generated by `cargo xtask new adapter`: the `delivery.sandbox` provider, and the starting point for a delivery marketplace adapter.
//!
//! The shape every delivery-marketplace adapter here has ([ADR-0176](../../../../docs/adr/0176-the-adapter-and-country-standard.md)):
//!
//! - **A transport seam.** [`Transport`] is the only thing that talks to the marketplace: it reads
//!   an order's state, sends a decision, sets the store's busy mode and lists the orders awaiting a
//!   decision. A real adapter puts the marketplace's API client behind it; the contract test puts
//!   an in-memory marketplace behind it.
//! - **A pure core.** [`SandboxDelivery`] implements `DeliveryVendor` over any transport and decides,
//!   with [`decide`], what an accept, a reject or a ready may do to an order in its current state.
//!   A decision repeated for the same platform order is one decision and sends nothing again. A
//!   decision after the window closed, a ready before an accept, or one that contradicts an earlier
//!   decision is `failed_precondition`. An order the marketplace does not know is `not_found`.
//!
//! The port carries the marketplace's order reference and the store's own order id, never the
//! customer's details, and nothing here logs. The sandbox is [`PROVIDER`], `delivery.sandbox`.

use pos_ports::{
    BusyMode, DeliveryVendor, PendingDecision, PortError, PortName, PrepTime, VendorOrderRef,
};
use pos_proto::{ReasonCodeId, StoreId};
use pos_providers::{Family, ProviderDescriptor};

/// This adapter as the provider catalogue lists it: a sandbox, which serves every country and asks
/// for no settings.
pub static PROVIDER: ProviderDescriptor = ProviderDescriptor {
    provider_id: "delivery.sandbox",
    family: Family::Delivery,
    name_key: "provider.delivery.sandbox",
    countries: &[],
    fields: &[],
    capabilities: &[],
    sandbox: true,
};

/// The marketplace, as the adapter sees it.
pub trait Transport: Send + Sync {
    /// Where the order `order_ref` stands, or `None` if the marketplace does not know it.
    ///
    /// # Errors
    ///
    /// [`Unreachable`] if the marketplace cannot be reached.
    fn order(&self, order_ref: &str) -> Result<Option<Status>, Unreachable>;

    /// Sends a decision on `order_ref`.
    ///
    /// # Errors
    ///
    /// [`Unreachable`] if the marketplace cannot be reached.
    fn send(&self, order_ref: &str, action: Action) -> Result<(), Unreachable>;

    /// Sets whether and how fast the store takes orders.
    ///
    /// # Errors
    ///
    /// [`Unreachable`] if the marketplace cannot be reached.
    fn set_busy(&self, store_id: StoreId, mode: BusyMode) -> Result<(), Unreachable>;

    /// The orders still awaiting the store's decision.
    ///
    /// # Errors
    ///
    /// [`Unreachable`] if the marketplace cannot be reached.
    fn pending(&self, store_id: StoreId) -> Result<Vec<PendingDecision>, Unreachable>;
}

/// The marketplace could not be reached.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Unreachable;

/// Where an order stands on the marketplace.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Status {
    /// Awaiting the store's decision, within its window.
    Pending,
    /// Awaiting a decision whose window has closed.
    Expired,
    /// Accepted.
    Accepted,
    /// Rejected.
    Rejected,
    /// Accepted and ready for collection.
    Ready,
}

/// A decision the store sends.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Action {
    /// Accept, promising a preparation time.
    Accept(PrepTime),
    /// Reject, with a reason from the cloud-managed list.
    Reject(ReasonCodeId),
    /// The food is ready for collection.
    Ready,
}

/// What `action` may do to an order in `current`: `Ok(true)` to send it, `Ok(false)` when it was
/// already made and nothing is sent again, or the port's refusal.
///
/// # Errors
///
/// [`PortError::failed_precondition`] if the window has closed, the order was never accepted, or the
/// action contradicts a decision already made.
pub fn decide(current: Status, action: Action) -> Result<bool, PortError> {
    let refuse = |why: &'static str| {
        Err(PortError::failed_precondition(
            PortName::DeliveryVendor,
            why,
        ))
    };
    match (current, action) {
        (Status::Accepted, Action::Accept(_))
        | (Status::Rejected, Action::Reject(_))
        | (Status::Ready, Action::Ready) => Ok(false),
        (Status::Expired, _) => refuse("the decision window has closed"),
        (Status::Pending, Action::Ready) => refuse("the order was never accepted"),
        (Status::Pending, Action::Accept(_) | Action::Reject(_))
        | (Status::Accepted, Action::Ready) => Ok(true),
        (Status::Accepted | Status::Rejected | Status::Ready, _) => {
            refuse("that would contradict a decision already made")
        }
    }
}

/// A `DeliveryVendor` over a [`Transport`].
#[derive(Debug)]
pub struct SandboxDelivery<T> {
    transport: T,
}

impl<T: Transport> SandboxDelivery<T> {
    /// A marketplace reached through `transport`.
    pub const fn new(transport: T) -> Self {
        Self { transport }
    }

    /// The transport, for a harness to inspect or stage.
    pub const fn transport(&self) -> &T {
        &self.transport
    }

    fn act(&self, order_ref: &VendorOrderRef, action: Action) -> Result<(), PortError> {
        let current = self
            .transport
            .order(order_ref.as_str())
            .map_err(|_| unreachable())?
            .ok_or_else(|| {
                PortError::not_found(
                    PortName::DeliveryVendor,
                    "the marketplace does not know this order",
                )
            })?;
        if decide(current, action)? {
            self.transport
                .send(order_ref.as_str(), action)
                .map_err(|_| unreachable())?;
        }
        Ok(())
    }
}

impl<T: Transport> DeliveryVendor for SandboxDelivery<T> {
    fn vendor_name(&self) -> &'static str {
        "sandbox"
    }

    async fn accept(
        &self,
        vendor_order_ref: &VendorOrderRef,
        prep_time: PrepTime,
    ) -> Result<(), PortError> {
        self.act(vendor_order_ref, Action::Accept(prep_time))
    }

    async fn reject(
        &self,
        vendor_order_ref: &VendorOrderRef,
        reason_code_id: ReasonCodeId,
    ) -> Result<(), PortError> {
        self.act(vendor_order_ref, Action::Reject(reason_code_id))
    }

    async fn mark_ready(&self, vendor_order_ref: &VendorOrderRef) -> Result<(), PortError> {
        self.act(vendor_order_ref, Action::Ready)
    }

    async fn set_busy(&self, store_id: StoreId, mode: BusyMode) -> Result<(), PortError> {
        self.transport
            .set_busy(store_id, mode)
            .map_err(|_| unreachable())
    }

    async fn pending_decisions(
        &self,
        store_id: StoreId,
    ) -> Result<Vec<PendingDecision>, PortError> {
        self.transport.pending(store_id).map_err(|_| unreachable())
    }
}

fn unreachable() -> PortError {
    PortError::unavailable(
        PortName::DeliveryVendor,
        "the marketplace could not be reached",
    )
}

#[cfg(test)]
mod provider_tests {
    use pos_providers::Registry;

    #[test]
    fn the_catalogue_accepts_this_adapters_descriptor() {
        let registry = Registry::new([&super::PROVIDER]).expect("a well-formed descriptor");
        assert!(registry.get("delivery.sandbox").is_some());
    }
}
