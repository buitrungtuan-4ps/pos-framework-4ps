[package]
name        = "storage-sandbox"
version     = "0.1.0"
description = "A sandbox `BlobStore` over a transport seam, generated by `cargo xtask new adapter`: the starting point for a storage adapter."
edition.workspace      = true
rust-version.workspace = true
license.workspace      = true
publish.workspace      = true
repository.workspace   = true

[dependencies]
pos-ports = { path = "../../pos-ports" }

[dev-dependencies]
pos-contract-tests = { path = "../../pos-contract-tests" }
pos-fakes = { path = "../../pos-fakes" }

[lints]
workspace = true

[package.metadata.pos]
layer = "adapter"
purpose = "A sandbox `BlobStore` over a transport seam, generated by `cargo xtask new adapter`: the starting point for a storage adapter."
adrs = [26, 176]
owners = ["@maintainers-architecture"]
