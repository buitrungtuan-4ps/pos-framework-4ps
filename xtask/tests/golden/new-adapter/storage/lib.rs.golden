//! A sandbox `BlobStore` over a transport seam, generated by `cargo xtask new adapter`: the starting point for a storage adapter.
//!
//! The shape every storage adapter here has ([ADR-0176](../../../../docs/adr/0176-the-adapter-and-country-standard.md)):
//!
//! - **A transport seam.** [`Transport`] is the only thing that touches the store: it puts, gets,
//!   deletes and lists raw keys. A real adapter puts an object-store client behind it; the contract
//!   test puts a map behind it.
//! - **A pure core.** [`SandboxStorage`] implements `BlobStore` over any transport and keeps the
//!   port's rules: an absent object is `None`, a delete of an absent object succeeds, a listing holds
//!   only keys under the prefix ([`BlobKey::is_under`], so `stores/1` never lists `stores/10`), and an
//!   unreachable store is `unavailable`.
//!
//! The port's futures are always ready: the transport is synchronous here. A real adapter whose
//! client is async awaits it in the same places.

use pos_ports::{BlobKey, BlobStore, PortError, PortName};

/// The store, as the adapter sees it. Keys are the port's keys as text.
pub trait Transport: Send + Sync {
    /// Stores `body` under `key`, replacing what was there.
    ///
    /// # Errors
    ///
    /// [`Unreachable`] if the store cannot be reached.
    fn put(&self, key: &str, body: &[u8]) -> Result<(), Unreachable>;

    /// The object under `key`, or `None` if there is none.
    ///
    /// # Errors
    ///
    /// [`Unreachable`] if the store cannot be reached.
    fn get(&self, key: &str) -> Result<Option<Vec<u8>>, Unreachable>;

    /// Removes the object under `key`. Removing an absent object is not an error.
    ///
    /// # Errors
    ///
    /// [`Unreachable`] if the store cannot be reached.
    fn delete(&self, key: &str) -> Result<(), Unreachable>;

    /// Every key that starts with `prefix` as text. The core narrows it to the keys under it.
    ///
    /// # Errors
    ///
    /// [`Unreachable`] if the store cannot be reached.
    fn keys(&self, prefix: &str) -> Result<Vec<String>, Unreachable>;
}

/// The store could not be reached.
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct Unreachable;

/// A `BlobStore` over a [`Transport`].
#[derive(Debug)]
pub struct SandboxStorage<T> {
    transport: T,
}

impl<T: Transport> SandboxStorage<T> {
    /// A store reached through `transport`.
    pub const fn new(transport: T) -> Self {
        Self { transport }
    }

    /// The transport, for a harness to inspect or fault-inject.
    pub const fn transport(&self) -> &T {
        &self.transport
    }

    fn list_now(&self, prefix: &BlobKey) -> Result<Vec<BlobKey>, PortError> {
        let mut keys = Vec::new();
        for text in self
            .transport
            .keys(prefix.as_str())
            .map_err(|_| unreachable())?
        {
            let key = BlobKey::parse(&text).map_err(|_| {
                PortError::internal(
                    PortName::BlobStore,
                    "the store holds a key the port cannot name",
                )
            })?;
            if key.is_under(prefix) {
                keys.push(key);
            }
        }
        Ok(keys)
    }
}

impl<T: Transport> BlobStore for SandboxStorage<T> {
    async fn put(&self, key: &BlobKey, body: &[u8]) -> Result<(), PortError> {
        self.transport
            .put(key.as_str(), body)
            .map_err(|_| unreachable())
    }

    async fn get(&self, key: &BlobKey) -> Result<Option<Vec<u8>>, PortError> {
        self.transport.get(key.as_str()).map_err(|_| unreachable())
    }

    async fn delete(&self, key: &BlobKey) -> Result<(), PortError> {
        self.transport
            .delete(key.as_str())
            .map_err(|_| unreachable())
    }

    async fn list(&self, prefix: &BlobKey) -> Result<Vec<BlobKey>, PortError> {
        self.list_now(prefix)
    }
}

fn unreachable() -> PortError {
    PortError::unavailable(PortName::BlobStore, "the store could not be reached")
}
