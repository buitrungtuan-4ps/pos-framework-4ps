//! The {{Provider}} [`{{Port}}`](pos_ports::{{port_module}}::{{Port}}) adapter, over HTTPS.
//!
//! {{One paragraph: which external system this is, and which port operations it maps.}}
//!
//! # A transport seam, and a pure core
//!
//! The socket lives behind [`{{Provider}}Transport`]; building the request and mapping the provider's
//! HTTP status to the right [`PortError`](pos_ports::PortError) are pure. That is what lets the shared
//! `{{Port}}` contract suite run in the fast pull-request gate against a stub, while the real TLS path
//! ([`Tls{{Provider}}Transport`]) is exercised in the gated integration lane and the soak — the split
//! ADR-0038 drew for the webhook sender and ADR-0058 for the couriers.
//!
//! # The exact provider wire is pinned in the gated lane
//!
//! The concrete endpoint paths, authentication, and vocabulary here are this adapter's own mapping;
//! the exact provider strings are confirmed against the live system in the gated integration lane.
//! What the fast gate proves is the port *semantics*, which do not change when a field is renamed.

#![forbid(unsafe_code)]

mod client;
mod wire;

pub use client::Http{{Provider}};
pub use wire::{{{Provider}}Transport, HttpResponse, Method, Tls{{Provider}}Transport, TransportError};

use pos_providers::{Family, ProviderDescriptor, fields};

/// This adapter as the provider catalogue lists it
/// ([ADR-0153](../../../docs/adr/0153-a-vendor-is-a-provider-the-cloud-chooses.md)): the vendor a
/// tenant connects to from the console, and what they fill in to do it.
///
/// - `provider_id` is `<family>.<vendor>`. It is stored in every connection a tenant makes, so it is
///   never renamed.
/// - `fields` is the form the console draws. Start from the shared ones in [`fields`] and add a field
///   only when this adapter reads it: a field declared before anything reads it is a question the
///   console asks and nothing uses. A credential is `FieldKind::Secret`; it is sealed on arrival and
///   never read back.
/// - `name_key` and each field's `label_key` need an entry in the console's catalogues
///   (`dashboard/src/i18n/{en,vi}.json`). Until they have one, the console shows the key itself.
pub static PROVIDER: ProviderDescriptor = ProviderDescriptor {
    provider_id: "{{family}}.{{vendor}}",                  // e.g. courier.grabexpress, erp.sap
    family: Family::{{Family}},                            // e.g. Courier, Erp
    name_key: "provider.{{family}}.{{vendor}}",
    countries: &[],                                        // empty = every country
    fields: &[fields::BASE_URL, fields::TIMEOUT_SECONDS],
    capabilities: &[],
    sandbox: false,
};

#[cfg(test)]
mod provider_tests {
    use pos_providers::Registry;

    /// The registry refuses a malformed id, a duplicate field, or a family the id does not name, so
    /// this is the build failure that stops a bad descriptor reaching the console.
    #[test]
    fn the_catalogue_accepts_this_adapters_descriptor() {
        let registry = Registry::new([&super::PROVIDER]).expect("a well-formed descriptor");
        assert!(registry.get(super::PROVIDER.provider_id).is_some());
    }
}
