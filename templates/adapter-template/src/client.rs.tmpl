//! The [`{{Port}}`] adapter over a [`{{Provider}}Transport`].
//!
//! Everything here is pure but for the one `await` on the transport: build the request body, map the
//! provider's vocabulary to the port's value types, and map the provider's HTTP status to the right
//! [`PortError`]. The status mapping is the load-bearing part — the port's contract turns on it.
//!
//! If the request carries personal data (a delivery address, an invoice buyer), say so here and in an
//! ADR, transmit it for the sole purpose the port needs, never log it, and never carry it back on the
//! returned value. See ADR-0058 for the courier's PDPD posture as a worked example.

use pos_ports::{{port_module}}::{{Port}};
use pos_ports::{PortError, PortName};

use crate::wire::{HttpResponse, Method, {{Provider}}Transport};

/// The port this adapter serves, for every [`PortError`] it raises.
const PORT: PortName = PortName::{{Port}};

/// The {{Provider}} [`{{Port}}`] adapter over a [`{{Provider}}Transport`].
#[derive(Debug, Clone)]
pub struct Http{{Provider}}<T> {
    transport: T,
}

impl<T> Http{{Provider}}<T> {
    /// Wraps a transport as a {{Provider}} channel.
    #[must_use]
    pub const fn new(transport: T) -> Self {
        Self { transport }
    }
}

