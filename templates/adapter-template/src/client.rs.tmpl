/// Maps a provider response to the port's value, or the right refusal.
///
/// `2xx` is success; each other status maps to the `PortError` the port's contract documents for that
/// case. A `2xx` body that does not parse is the provider breaking its own contract
/// ([`internal`](PortError::internal)). Never coerce an unknown provider status to a known one —
/// preserve it as an unrecognised value so it stays non-terminal / unresolved, the safe direction.
#[expect(dead_code, reason = "template skeleton: filled in per port")]
fn parse_something(response: &HttpResponse) -> Result<(), PortError> {
    match response.status {
        200..=299 => Ok(()),
        400 => Err(PortError::invalid_argument(PORT, "…")),
        404 => Err(PortError::not_found(PORT, "…")),
        409 => Err(PortError::failed_precondition(PORT, "…")),
        other => Err(PortError::unavailable(
            PORT,
            format!("the {{provider}} returned HTTP {other}"),
        )),
    }
}

