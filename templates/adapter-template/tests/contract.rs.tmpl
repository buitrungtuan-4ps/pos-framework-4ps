// Implement the port's `…Harness` trait: `fresh()` returns `Http{{Provider}}::new(stub)`, and any
// setup hook the harness declares reaches into the stub's state.

// Drives a future to completion; the stub touches no socket, so a current-thread runtime suffices.
fn block_on<F: Future>(future: F) -> F::Output {
    tokio::runtime::Builder::new_current_thread()
        .enable_all()
        .build()
        .expect("build a current-thread tokio runtime")
        .block_on(future)
}

