# Rename to `Cargo.toml`. Copy the dependency block below verbatim — every crate here is already in
# the tree at these versions via the sibling adapters, so it adds direct-dependency lines, not a new
# subtree, and needs no new cargo-deny entry.
[package]
name        = "{{adapter-name}}"                          # e.g. shipping-grabexpress, erp-sap
version     = "0.1.0"
description = "{{one line: what this adapter does, over what transport}}"
edition.workspace      = true
rust-version.workspace = true
license.workspace      = true
publish.workspace      = true
repository.workspace   = true

[dependencies]
# The backbone this adapter implements: the port, its value types, and PortError. Paths, not versions.
pos-ports = { path = "../../pos-ports" }
pos-proto = { path = "../../pos-proto" }

serde      = { workspace = true }
serde_json = { workspace = true }
thiserror  = { workspace = true }

# The tree's pinned rustls/hyper stack (ADR-0038, ADR-0054, ADR-0058). `ring` is pinned so feature
# unification cannot pull aws-lc-rs; roots are the bundled webpki-roots Mozilla set. One fixed,
# trusted host => no SSRF surface.
hyper           = { version = "1", features = ["client", "http1"] }
hyper-util      = { version = "0.1", features = ["tokio"] }
http-body-util  = "0.1"
bytes           = "1"
tokio           = { version = "1", features = ["net", "time", "rt"] }
tokio-rustls    = { version = "0.26", default-features = false, features = ["ring", "tls12", "logging"] }
webpki-roots    = "1"
url             = "2"

[dev-dependencies]
# The shared contract suite for your port. It runs against the stub transport in tests/contract.rs.
pos-contract-tests = { path = "../../pos-contract-tests" }

[lints]
workspace = true
