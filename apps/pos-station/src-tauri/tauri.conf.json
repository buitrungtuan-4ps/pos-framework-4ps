{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POS Station",
  "mainBinaryName": "pos-station",
  "version": "0.1.0",
  "identifier": "com.pizza4ps.pos-station",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "capabilities": ["local-pages"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis"],
    "publisher": "Pizza 4P's",
    "category": "Business",
    "shortDescription": "The till, the store PC's tray and the print agent in one app.",
    "longDescription": "POS Station loads the till from the store's edge, keeps its pairing in the OS credential store, shows the edge, cloud link, outbox and printers in the tray on the store PC, and runs the print agent on other machines.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/etc/xdg/autostart/pos-station.desktop": "linux/pos-station-autostart.desktop"
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../../../deploy/release/sign-windows.ps1",
          "-Path",
          "%1"
        ]
      },
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
